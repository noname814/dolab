- name: Setup Simple Web Application Infrastructure
  hosts: webservers
  become: yes   # run as sudo/root

  tasks:

    - name: Install Apache web server
      apt:
        name: apache2
        state: present
        update_cache: yes

    - name: Start and enable Apache service
      service:
        name: apache2
        state: started
        enabled: yes

    - name: Deploy sample web page
      copy:
        dest: /var/www/html/index.html
        content: |
          <html>
          <head><title>My Web App</title></head>
          <body>
          <h1>Welcome to My Web Application</h1>
          <p>Deployed using Ansible</p>
          </body>
          </html>

    - name: Ensure Apache is running
      service:
        name: apache2
        state: restarted

run:--ask-become-pass




trigger:
- main

jobs:
- job: JobA
  displayName: "First Job"
  pool:
    vmImage: 'ubuntu-latest'
  steps:
  - script: echo "Running Job A"

- job: JobB
  displayName: "Second Job"
  dependsOn: JobA
  pool:
    vmImage: 'ubuntu-latest'
  steps:
  - script: echo "Running Job B after Job A"

- job: JobC
  displayName: "Third Job"
  dependsOn: JobB
  pool:
    vmImage: 'ubuntu-latest'
  steps:
  - script: echo "Running Job C after Job B"
